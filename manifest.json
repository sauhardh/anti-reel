{
  "name": "Anti Reel",
  "description": "Hide Shorts / Reels from homepage and search results.",
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://www.facebook.com/*",
    "*://www.instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["/scripts/youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.facebook.com/*"],
      "js": ["/scripts/facebook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.instagram.com/*"],
      "js": ["/scripts/instagram.js"],
      "run_at": "document_idle"
    }
  ],
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "/popup/popup.html",
    "default_icon": "/images/anti-reels.png"
  }
}
